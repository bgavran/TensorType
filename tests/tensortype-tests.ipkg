-- homepage =
-- sourceloc =
-- bugtracker =

-- the Idris2 version required (e.g. langversion >= 0.5.1)
-- langversion

-- packages to add to search path
depends = tensortype
        , hedgehog

-- modules to install
modules = Display2D.Instances
        , Display2D.Expected
        , Tensor.Interfaces
        , Tensor.Indexing
        , Tensor.Axis
        , Tensor.Softargmax
        , Tensor.Contractions
        , Train.LinearRegression
        , Train.Optimisers
        , Sampling
        , Main

-- main file (i.e. file to load at REPL)
main = Main

-- name of executable
executable = "tensortype-tests"
opts = "--total"
sourcedir = "src"
